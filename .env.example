# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MUSIXMATCH_API_KEY: Optional API key for Musixmatch official track search, charts, and synced lyrics.
MUSIXMATCH_API_KEY=""

# LASTFM_API_KEY: Optional API key for Last.fm official track discovery, global charts, and artist top tracks.
LASTFM_API_KEY=""

# JAMENDO_CLIENT_ID: Optional free Client ID from developer.jamendo.com for licensed indie MP3 catalog.
JAMENDO_CLIENT_ID=""

# GAANA_PROXY_URL: Optional Indian egress relay URL for bypassing regional Gaana blocks when hosted outside India.
GAANA_PROXY_URL=""

# VITE_API_BASE_URL: Full HTTPS origin of the Aura Music backend when building the Capacitor Android app (e.g. https://your-deployed-backend.example.com). Leave empty for web same-origin hosting.
VITE_API_BASE_URL=""
